# unidoc-ndppd configuration
# Default path: /opt/unidoc/etc/unidoc-ndppd.conf

# Top-level tuning (all optional; sensible defaults built in)

# invalid-ttl <ms>    — how long a failed session stays cached (absorbs NS floods)
#invalid-ttl 10000

# valid-ttl <ms>      — how long a VALID session survives without a fresh NA
#valid-ttl 30000

# retrans-time <ms>   — interval between outgoing NS probes
#retrans-time 1000

# retrans-limit <n>   — number of NS probes before giving up
#retrans-limit 3

# keepalive <yes|no>  — keep probing STALE sessions without upstream NS traffic
#keepalive no

# proxy <interface> { ... }
proxy eth0 {
    # router <yes|no> — set Router flag in NAs (yes if targets are routers, e.g. downstream CPE)
    router yes

    # promiscuous <yes|no>
    # Linux: default `no` uses PACKET_MR_ALLMULTI (catches solicited-node multicast NS).
    #        Set `yes` for PACKET_MR_PROMISC — needed only when you must also receive
    #        unicast NS aimed at MACs other than your own (bridged / veth churn setups).
    # FreeBSD: BPF requires promiscuous mode as a kernel constraint; flag is ignored there.
    #promiscuous no

    # target <mac> — override advertised source MAC for NAs generated by this proxy (optional)
    #target 02:00:00:00:00:01

    # rule <ipv6>[/<prefix>] { ... } — one rule per (sub)prefix you proxy for
    rule 2001:db8:0:0:100::/80 {
        # Exactly one of the following is required:
        #   auto              — resolve via routing table
        #   static            — reply immediately for every address in the prefix
        #   iface <name>      — forward NS to a specific downstream interface
        iface eth1

        # autowire   — add /128 host route on VALID, remove on session expiry (iface mode only)
        #autowire

        # table <n>  — routing table for autowire (Linux only, 0-255; default 254 = main)
        #table 254

        # target <mac> — per-rule advertised MAC override (optional)
        #target 02:00:00:00:00:01

        # rewrite <prefix>/<pflen> — rewrite target before forwarding to iface (optional)
        #rewrite fd00::/48
    }
}
